digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
s [label="{OrderService||+ createOrder(Employee) Order\l+ validateForConfirm(Order)\l}", fillcolor="#FDE9E7", color="#C00000"];
o [label="{Order|- employee Employee\l- items List[OrderItem]\l- status OrderStatus\l|+ addProduct(Product,int)\l+ removeProduct(String)\l+ total() double\l+ confirm()\l+ getItems() List\l}", fillcolor="#FDE9E7", color="#C00000"];
oi [label="{OrderItem|{MAX_QUANTITY=40\l}|- product Product\l- quantity int\l|+ increase(int)\l+ getLineTotal() double\l}", fillcolor="#FDE9E7", color="#C00000"];
p [label="{Product|- id String\l- name String\l- price double\l|+ getPrice() double\l}", fillcolor="#F7FBFF"];
e [label="{Employee||+ Employee(...)\l}", fillcolor="#F7FBFF"];
s -> o [label="uses",style=dashed,arrowhead=open];
o -> e [label="1",arrowtail=odiamond,dir=both];
o -> oi [label="1..*",arrowtail=diamond,dir=both];
oi -> p [label="1",arrowtail=odiamond,dir=both];
}